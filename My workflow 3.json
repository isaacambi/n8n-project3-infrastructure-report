        "jsCode": "const data = $input.first().json;\n\nconst prompt = `You are an infrastructure monitoring assistant. Analyze the following server health data and write a professional daily infrastructure report in 3-4 paragraphs. Highlight any concerning values — memory above 80%, disk above 85%, or CPU above 80%. Be clear and concise, suitable for both engineers and managers.\n\nServer Health Data as of ${data.timestamp}:\n- Hostname: ${data.hostname}\n- CPU Usage: ${data.cpu_usage_percent}\n- Memory: ${data.memory.used_mb}MB used out of ${data.memory.total_mb}MB (${data.memory.usage_percent}% used)\n- Disk: ${data.disk}\n- Uptime: ${data.uptime}`;\n\nreturn [{ json: { prompt } }];"
